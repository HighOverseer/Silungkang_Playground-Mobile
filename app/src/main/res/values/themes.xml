<!--BottomNavigation-->

    <style name="BottomNavigation">
        <item name="itemTextColor">@color/menu_item_text_color</item>
        <item name="itemPaddingTop">20dp</item>
        <item name="itemPaddingBottom">11dp</item>
        <item name="itemIconSize">30dp</item>
        <item name="itemActiveIndicatorStyle">@null</item>
        <item name="itemIconTint">@null</item>
        <item name="itemRippleColor">@android:color/transparent</item>
        <item name="itemTextAppearanceActiveBoldEnabled">true</item>
        <item name="itemTextAppearanceActive">@style/BottomNavigationItemTextActive</item>
        <item name="itemTextAppearanceInactive">@style/BottomNavigationItemTextInactive</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="android:clipToPadding">true</item>
        <item name="itemBackground">@drawable/container_shadow_bg</item>
        <item name="android:background">@color/white</item>
        <item name="menu">@menu/mainpage_menu</item>
    </style>


    <!--MaterialCardView Play Menu in Dashboard-->
    <style name="PlayMenuCard">
        <item name="strokeWidth">0dp</item>
        <item name="cardCornerRadius">5dp</item>
        <item name="contentPaddingTop">11dp</item>
        <item name="contentPaddingBottom">11dp</item>
        <item name="contentPaddingLeft">24dp</item>
        <item name="contentPaddingRight">24dp</item>
        <item name="cardBackgroundColor">@color/purple</item>
    </style>


    <style name="BottomNavigationItemTextActive">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/purple_100</item>
    </style>

    <style name="BottomNavigationItemTextInactive">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">@color/grey_250</item>
    </style>


    <!--Member History Table Style-->

    <style name="MemberHistoryTableColumnHeaderNo" parent="TextView.White.12sp.Medium">
        <item name="android:gravity">center</item>
        <item name="android:textAlignment">gravity</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:ems">3</item>
        <item name="android:minEms">3</item>
    </style>

    <style name="MemberHistoryTableColumnHeaderInformation" parent="TextView.White.12sp.Medium">
        <item name="android:textAlignment">center</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

   <style name="MemberHistoryTableColumnHeaderDate" parent="TextView.White.12sp.Medium">
       <item name="android:gravity">center</item>

        <item name="android:textAlignment">gravity</item>
        <item name="android:letterSpacing">0.01</item>
    </style>


    <style name="MemberHistoryTableColumnNo" parent="TextView.Black.11sp.Regular">
        <item name="android:gravity">center</item>
        <item name="android:padding">8dp</item>
        <item name="android:textAlignment">gravity</item>
        <item name="android:ems">3</item>
        <item name="android:minEms">3</item>
    </style>

    <style name="MemberHistoryTableSeparator">"
        <item name="android:letterSpacing">0.01</item>
        <item name="android:background">@color/grey_750</item>
    </style>

    <style name="MemberHistoryTableColumnInformation" parent="TextView.Black.11sp.Regular">
        <item name="android:letterSpacing">0.01</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textAlignment">gravity</item>
        <item name="android:inputType">textMultiLine</item>
        <item name="android:padding">8dp</item>
        <item name="android:lineSpacingExtra">5dp</item>
    </style>

    <style name="MemberHistoryTableColumnDate" parent="MemberHistoryTableColumnInformation">
        <item name="android:gravity">center</item>
    </style>

