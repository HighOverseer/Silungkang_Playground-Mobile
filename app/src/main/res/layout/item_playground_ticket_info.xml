<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    app:strokeWidth="0dp"
    app:cardCornerRadius="10dp"
    app:cardBackgroundColor="@color/purple_50">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/actv_info"
            android:layout_marginTop="15dp"
            android:layout_marginHorizontal="15dp"
            style="@style/TextView.Purple100.12sp.SemiBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/harga_ticket"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/actv_additional_info"
            style="@style/TextView.Purple100.8sp.Light"
            android:layout_width="0dp"
            app:layout_constraintEnd_toStartOf="@id/logo"
            android:layout_height="wrap_content"
            android:layout_marginEnd="32dp"
            android:text="@string/harga_tiket_sudah_termasuk_1_orang_pendamping"
            app:layout_constraintTop_toBottomOf="@id/actv_info"
            app:layout_constraintStart_toStartOf="@id/actv_info"/>


        <id.rla.silungkangplayground.presentation.customview.TicketInfoTableLayout
            android:id="@+id/tl_ticketDayPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:layout_constraintTop_toBottomOf="@id/actv_additional_info"
            app:layout_constraintStart_toStartOf="@id/actv_additional_info"
            android:layout_marginBottom="15dp"
            app:layout_constraintBottom_toBottomOf="parent"/>

