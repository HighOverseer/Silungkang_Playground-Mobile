<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".presentation.feature.mainpage.MainPageActivity">


<com.google.android.material.appbar.AppBarLayout
    android:id="@+id/app_bar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="8dp"
    android:background="@drawable/toolbar_dropshadow"
    android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"

        android:layout_height="?attr/actionBarSize"
        android:popupTheme="@style/ThemeOverlay.AppCompat.Light">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="115dp"
                android:layout_height="36dp"
                app:srcCompat="@drawable/logo"
                android:layout_gravity="start"
                android:scaleType="fitCenter"
                android:layout_marginStart="4dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/actv_current_active_member"
                style="@style/TextView.Black.14sp.SemiBold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                app:layout_constraintWidth_max="120dp"
                android:ellipsize="end"
                android:textAlignment="textEnd"
                android:maxLines="1"
                android:maxLength="12"
                tools:text="Fajar Alif Riyandi"
                app:layout_constraintStart_toEndOf="@id/guideline"
                app:layout_constraintEnd_toStartOf="@id/civ_account_profile_icon"
                app:layout_constraintTop_toTopOf="@id/civ_account_profile_icon"
                app:layout_constraintBottom_toBottomOf="@id/civ_account_profile_icon"
                />

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/civ_account_profile_icon"
                android:layout_width="38dp"
                android:layout_height="38dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:src="@drawable/ic_avatar"
                android:layout_gravity="end"
                android:layout_marginEnd="20dp"/>


            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guideline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_percent="0.65"
                android:orientation="vertical"/>


        </androidx.constraintlayout.widget.ConstraintLayout>


    </androidx.appcompat.widget.Toolbar>

</com.google.android.material.appbar.AppBarLayout>

<include
    android:id="@+id/content"
    layout="@layout/content_mainpage"/>



</androidx.coordinatorlayout.widget.CoordinatorLayout>