<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    app:strokeWidth="0dp"
    app:cardCornerRadius="10dp"
    app:cardBackgroundColor="@color/purple_50">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/actv_info"
            android:layout_marginTop="15dp"
            android:layout_marginHorizontal="15dp"
            style="@style/TextView.Purple100.12sp.Light"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/operational_hours"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/actv_time"
            style="@style/TextView.Purple100.22sp.SemiBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="10:00-21:00 WIB"
            android:layout_marginBottom="15dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/actv_info"
            app:layout_constraintStart_toStartOf="@id/actv_info"/>

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="150dp"
            android:layout_height="82dp"
            android:src="@drawable/logo_bg_purple"
            android:scaleType="fitCenter"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginEnd="-36dp"
            android:alpha="0.5"
            android:layout_marginBottom="-16dp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>



</com.google.android.material.card.MaterialCardView>