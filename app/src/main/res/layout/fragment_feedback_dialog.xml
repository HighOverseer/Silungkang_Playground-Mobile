<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:contentPaddingTop="14dp"
    app:contentPaddingBottom="22dp"
    app:strokeWidth="0dp"
    app:cardCornerRadius="20dp"
    app:contentPaddingLeft="39dp"
    app:cardBackgroundColor="@color/white"
    app:contentPaddingRight="39dp"
    tools:context=".presentation.feature.feedback.FeedbackDialogFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/actv_info"
            style="@style/TextView.Black.14sp.SemiBold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="1dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:text="@string/bagaimana_pengalaman_di_nplayground_hari_ini"
            android:textAlignment="center"/>

        <LinearLayout
            android:id="@+id/ll_stars"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:showDividers="middle"
            app:layout_constraintTop_toBottomOf="@id/actv_info"
            android:layout_marginTop="8dp"
            android:divider="@drawable/stars_review_divider"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/aciv_star1"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_star_drawable"
                android:scaleType="fitCenter"/>

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/aciv_star2"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_star_drawable"
                android:scaleType="fitCenter"/>

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/aciv_star3"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_star_drawable"
                android:scaleType="fitCenter"/>

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/aciv_star4"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_star_drawable"
                android:scaleType="fitCenter"/>

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/aciv_star5"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_star_drawable"
                android:scaleType="fitCenter"/>

        </LinearLayout>

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/TextView.Grey650.10sp.Regular"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAlignment="textStart"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/ll_stars"
            android:letterSpacing="0.03"
            app:layout_constraintBottom_toTopOf="@id/acet_review"
            app:layout_constraintStart_toStartOf="@id/acet_review"
            android:text="@string/kritik_dan_saran"/>
        
        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/acet_review"
            style="@style/TextView.Black.10sp.Regular"
            android:layout_width="214dp"
            android:layout_height="wrap_content"
            android:minLines="4"
            android:maxLength="200"
            android:layout_gravity="center"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            tools:text="sdfdsfsdfsfsfsdfsffsfsdfsfddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd"
            android:gravity="start|top"
            android:layout_marginBottom="11dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/acb_submit"
            android:background="@drawable/rad5_stroke_grey_bg"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/acb_submit"
            style="@style/Button.12sp.Medium"
            android:layout_width="79dp"
            android:layout_height="27dp"
            android:layout_marginTop="12dp"
            android:layout_gravity="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:text="@string/submit"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>